# App
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-string
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Use this for a no-Docker local run. Docker Compose overrides it with PostgreSQL.
DATABASE_URL=sqlite:///./chronos.db

# Google OAuth / Gmail API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NVIDIA NIM (free hosted development endpoint)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k3

# Worker
WORKER_POLL_SECONDS=5
WORKER_LOCK_TIMEOUT_MINUTES=5

