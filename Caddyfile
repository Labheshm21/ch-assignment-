{$APP_DOMAIN} {
    encode zstd gzip

    handle /api/* {
        reverse_proxy api:8000
    }

    handle /auth/* {
        reverse_proxy api:8000
    }

    handle /health {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy frontend:3000
    }
}

{$N8N_DOMAIN} {
    encode zstd gzip
    reverse_proxy n8n:5678
}
