# Public hostname only; do not include https://
APP_DOMAIN=203.0.113.10.sslip.io

# Application
APP_ENV=production
APP_SECRET_KEY=replace-with-a-long-random-string
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
FRONTEND_URL=https://203.0.113.10.sslip.io
BACKEND_URL=https://203.0.113.10.sslip.io

# PostgreSQL (use URL-safe letters and numbers for this demo password)
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Google OAuth / Gmail API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k3

# Worker
WORKER_POLL_SECONDS=5
WORKER_LOCK_TIMEOUT_MINUTES=5
